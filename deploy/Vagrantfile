Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/noble64"
  config.vm.hostname = "lfsrc-harness"
  config.vm.network "forwarded_port", guest: 8619, host: 8619, auto_correct: true
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
  end
  config.vm.synced_folder "..", "/opt/lfsrc-src", type: "virtualbox"
  config.vm.provision "shell", inline: <<-SHELL
    sudo bash "/opt/lfsrc-src/deploy/install.sh" --root "/opt/lfsrc"
  SHELL
end
